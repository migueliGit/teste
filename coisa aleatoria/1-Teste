let inTitulo = document.getElementById("inTitulo");
let inDuracao = document.getElementById("inDuracao").value;
let outTitulo = document.getElementById("outTitulo");
let outResposta = document.getElementById("outResposta");

//obtem   conteudos dos campos de entrada 
let titulo = inTitulo.value;
let duracao = Number(inDuracao);

//arredonda para baixo o resultado da divisao
let horas = Math.floor(duracao / 60);
//obtem o resto da divisao entre os numeros
let minutos = duracao % 2;
// altera o conteudo dos paragrafos de resposta
outTitulo.textContent = titulo;
outResposta.textContent = horas + "hora(s) e" + minutos + "minuto(s)";
}


